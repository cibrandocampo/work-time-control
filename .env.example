# Work Time Control - Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=wtc
POSTGRES_USER=wtc
POSTGRES_PASSWORD=wtc_dev_password

# =============================================================================
# Application Configuration
# =============================================================================
# Debug mode (set to False in production)
DEBUG=True

# Django secret key (required in production when DEBUG=False)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# =============================================================================
# Port Configuration (optional, defaults shown)
# =============================================================================
# DB_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173

# =============================================================================
# External Time Manager Integration (optional)
# =============================================================================
# Base URL of the external time manager API (without trailing slash)
# EXTERNAL_TIME_MANAGER_URL=https://your-time-manager.example.com

# Note: Company external ID is configured in Django admin (Companies > Company)
# Note: User external ID is configured per-user in Django admin or frontend Settings
